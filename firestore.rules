rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    match /products/{productId} {
      allow read: if true;
      allow write: if false;
    }

    match /users/{userId}/{document=**} {
        allow read, write: if request.auth.uid == userId;
    }
    
    // Fix for the Testimonials error
    match /testimonials/{testimonialId} {
      allow read: if true;
      allow write: if request.auth.uid != null; // Allow authenticated users to add testimonials
    }
    
    match /orders/{orderId} {
      allow create: if request.auth.uid != null;

      // LAST ATTEMPT: This rule covers all possibilities:
      // 1. The user's ID is in a 'userId' field.
      // 2. The user's ID is in a nested 'user.uid' field.
      // 3. The user's ID IS the document ID of the order itself.
      allow read: if request.auth.uid == resource.data.userId || 
                   request.auth.uid == resource.data.user.uid ||
                   request.auth.uid == orderId;
      
      allow update, delete: if false; 
    }
  }
}
